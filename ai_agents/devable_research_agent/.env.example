# Copy to .env or ~/.config/morning-ai/.env and fill in values.

# Project root for cross-platform paths (OpenClaw prompt, pipeline scripts)
DEVABLE_PROJECT_ROOT=C:\Users\HP\Documents\MorningAI

MESSAGE_ENABLED=true
ARXIV_LOOKBACK_DAYS=1

GITHUB_TOKEN=
TAVILY_API_KEY=
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
MISTRAL_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
