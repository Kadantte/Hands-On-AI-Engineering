# TrueForge server URL. Local mode default is http://localhost:8790.
TRUEFORGE_BASE_URL=http://localhost:8790

# The saved agent name to run (created in the TrueForge UI in Setup step 3).
TRUEFORGE_AGENT=web-research-brief

# Only for hosted mode with OIDC login. Leave unset in local mode.
# TRUEFORGE_TOKEN=your-oidc-id-token
